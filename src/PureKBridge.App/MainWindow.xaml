<Window x:Class="PureKBridge.App.MainWindow" x:Name="Root"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:PureKBridge.App.Views"
 xmlns:info="clr-namespace:PureKBridge.App.Services"
 Title="{x:Static info:AboutInfo.Name}" Width="760" Height="640" MinWidth="640" MinHeight="520"
 WindowStartupLocation="CenterScreen">
 <Grid Margin="32,20,32,16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
   <RowDefinition Height="*" /><RowDefinition Height="Auto" />
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22">
   <StackPanel Orientation="Horizontal">
    <Viewbox Width="23" Height="23" Margin="0,0,10,0">
     <Path Stroke="#0067C0" StrokeThickness="1.7" Data="M2,3 L22,3 22,17 2,17 Z M8,22 L16,22 M12,17 L12,22" />
    </Viewbox>
    <TextBlock Text="{Binding AppTitle}" FontSize="22" FontWeight="SemiBold" />
   </StackPanel>
   <TextBlock Text="连接当前纯K房间的投屏设备" Foreground="#656565" Margin="0,5,0,0" />
  </StackPanel>
  <Border Grid.Row="1" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="0,0,0,17" Margin="0,0,0,21">
   <ItemsControl ItemsSource="{Binding Steps}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0">
       <Border.Style><Style TargetType="Border">
        <Setter Property="Background" Value="#EEEEF0" />
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="#0067C0" /></DataTrigger>
         <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Background" Value="#167A33" /></DataTrigger>
        </Style.Triggers>
       </Style></Border.Style>
       <TextBlock Text="{Binding Bullet}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11">
        <TextBlock.Style><Style TargetType="TextBlock">
         <Setter Property="Foreground" Value="#777777" />
         <Style.Triggers>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger>
          <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger>
         </Style.Triggers>
        </Style></TextBlock.Style>
       </TextBlock>
      </Border>
      <TextBlock Text="{Binding Label}" VerticalAlignment="Center">
       <TextBlock.Style><Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="#999999" />
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Foreground" Value="#202020" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
         <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="Foreground" Value="#656565" /></DataTrigger>
        </Style.Triggers>
       </Style></TextBlock.Style>
      </TextBlock>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </Border>
  <Border Grid.Row="2" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"
   Background="#FDECEE" BorderBrush="#F4CFD2" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
   <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#A32620" />
  </Border>
  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,8">
   <Grid>
    <views:ScanView Visibility="{Binding IsScanPage, Converter={StaticResource BoolVisibility}}" />
    <views:WechatView Visibility="{Binding IsWechatPage, Converter={StaticResource BoolVisibility}}" />
    <views:ConnectView Visibility="{Binding IsConnectPage, Converter={StaticResource BoolVisibility}}" />
    <views:ConnectedView Visibility="{Binding IsDonePage, Converter={StaticResource BoolVisibility}}" />
   </Grid>
  </ScrollViewer>
  <Grid Grid.Row="4" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid VerticalAlignment="Center" Margin="0,0,8,0">
    <TextBlock Text="{Binding ModeCaption}" Foreground="#8A6A2D" FontSize="11" TextWrapping="Wrap">
     <TextBlock.Style><Style TargetType="TextBlock">
      <Style.Triggers><DataTrigger Binding="{Binding TrayBehavior.IsAutoHidePending, ElementName=Root}" Value="True">
       <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger></Style.Triggers>
     </Style></TextBlock.Style>
    </TextBlock>
    <TextBlock x:Name="AutoHideNotice" DataContext="{Binding TrayBehavior, ElementName=Root}" Foreground="#656565" FontSize="11" TextWrapping="Wrap"
     Visibility="{Binding IsAutoHidePending, Converter={StaticResource BoolVisibility}}">
     <Run Text="{Binding AutoHideMessage, Mode=OneWay}" /><Hyperlink x:Name="CancelHideLink" Command="{Binding CancelHideCommand}">取消隐藏</Hyperlink>
    </TextBlock>
   </Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <CheckBox Content="关闭或最小化时隐藏到托盘" FontSize="11" VerticalAlignment="Center"
     IsChecked="{Binding TrayBehavior.CloseToTray, ElementName=Root, Mode=TwoWay}" />
    <Button Content="关于" Style="{StaticResource TextButton}" Click="OpenAbout" Margin="8,0,0,0" />
   </StackPanel>
   <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="开发调试" HorizontalAlignment="Right" FontSize="11" Visibility="{Binding IsDebugBuild, Converter={StaticResource BoolVisibility}}">
    <WrapPanel MaxWidth="390" Margin="4,10,0,0">
     <Button Content="演示房间" Command="{Binding DebugCommand}" CommandParameter="room" Padding="8,4" Margin="0,0,4,4" />
     <Button Content="连接成功" Command="{Binding DebugCommand}" CommandParameter="success" Padding="8,4" Margin="0,0,4,4" />
     <Button Content="无法访问" Command="{Binding DebugCommand}" CommandParameter="unreachable" Padding="8,4" Margin="0,0,4,4" />
     <Button Content="连接失败" Command="{Binding DebugCommand}" CommandParameter="failure" Padding="8,4" Margin="0,0,4,4" />
     <Button Content="设备离线" Command="{Binding DebugCommand}" CommandParameter="offline" Padding="8,4" Margin="0,0,4,4" />
    </WrapPanel>
   </Expander>
  </Grid>
 </Grid>
</Window>
