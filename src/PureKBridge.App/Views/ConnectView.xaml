<UserControl x:Class="PureKBridge.App.Views.ConnectView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="3. 连接此电脑" Style="{StaticResource ViewTitle}" />
  <TextBlock Text="{Binding ConnectionIntroduction}" Style="{StaticResource Description}" />
  <Border Style="{StaticResource InfoPanel}">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="房间" Style="{StaticResource InfoLabel}" /><TextBlock Grid.Column="1" Text="{Binding RoomName}" Style="{StaticResource InfoValue}" />
    <TextBlock Grid.Row="1" Text="Renderer" Style="{StaticResource InfoLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RendererDisplay}" Style="{StaticResource InfoValue}" />
    <TextBlock Grid.Row="2" Text="本机地址" Style="{StaticResource InfoLabel}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LocalAddress}" Style="{StaticResource InfoValue}" />
    <TextBlock Grid.Row="3" Text="状态" Style="{StaticResource InfoLabel}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RendererStatus}" Style="{StaticResource InfoValue}" />
   </Grid>
  </Border>
  <StackPanel Visibility="{Binding IsConnecting, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,20">
   <ProgressBar Height="3" IsIndeterminate="{Binding IsConnecting}" BorderThickness="0" Foreground="#0067C0" Background="#E5EDF7" />
   <TextBlock Text="{Binding ConnectionMessage}" Foreground="#656565" Margin="0,12,0,0" />
  </StackPanel>
  <StackPanel Orientation="Horizontal">
   <Button Content="连接此电脑" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" />
   <Button Content="返回" Command="{Binding BackCommand}" />
   <Button Content="重新识别" Command="{Binding ResetCommand}" Style="{StaticResource TextButton}" />
  </StackPanel>
 </StackPanel>
</UserControl>
