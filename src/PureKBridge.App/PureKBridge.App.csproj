<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ChunK Helper</AssemblyName>
    <Product>纯K助手</Product>
    <Title>纯K助手</Title>
    <Version>0.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>PureKBridge.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PureKBridge.Core\PureKBridge.Core.csproj" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="ChunK.Notices.LICENSE" />
    <EmbeddedResource Include="..\..\licenses\Apache-2.0.txt" LogicalName="ChunK.Notices.Apache-2.0.txt" />
    <EmbeddedResource Include="..\..\licenses\runtime\*.txt" LogicalName="ChunK.Notices.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
