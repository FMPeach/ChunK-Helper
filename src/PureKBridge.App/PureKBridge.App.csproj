<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ChunK Helper</AssemblyName>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>PureKBridge.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\PureKBridge.Core\PureKBridge.Core.csproj" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="ChunK.Notices.LICENSE" />
    <EmbeddedResource Include="..\..\licenses\Apache-2.0.txt" LogicalName="ChunK.Notices.Apache-2.0.txt" />
    <EmbeddedResource Include="..\..\licenses\runtime\*.txt" LogicalName="ChunK.Notices.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ReadKirakaraPackageMetadata" BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <_KirakaraMetadata>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'package'))</_KirakaraMetadata>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\tools\generate-package-metadata.ps1&quot; -OutputDirectory &quot;$(_KirakaraMetadata)&quot; -VersionOverride &quot;$(KirakaraPackageVersion)&quot;" />
    <PropertyGroup>
      <InformationalVersion>$([System.IO.File]::ReadAllText('$(_KirakaraMetadata)\version.txt'))</InformationalVersion>
      <FileVersion>$([System.IO.File]::ReadAllText('$(_KirakaraMetadata)\fileVersion.txt'))</FileVersion>
      <Version>$(FileVersion)</Version>
      <Product>$([System.IO.File]::ReadAllText('$(_KirakaraMetadata)\name.txt'))</Product>
      <Title>$(Product)</Title>
      <Company>$([System.IO.File]::ReadAllText('$(_KirakaraMetadata)\developer.txt'))</Company>
    </PropertyGroup>
  </Target>
</Project>
